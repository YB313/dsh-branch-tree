{
  "name": "dsh-branch-tree",
  "version": "1.3.1",
  "description": "Turn a DeepSeek Harness session into a folder: fork it into independent branches (full copy, compressed memory, or opening only) and browse them as a tree in the left workspace column.",
  "type": "module",
  "license": "MIT",
  "author": "Yige Bao (YB313)",
  "homepage": "https://github.com/YB313/dsh-branch-tree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YB313/dsh-branch-tree.git"
  },
  "bugs": {
    "url": "https://github.com/YB313/dsh-branch-tree/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "branch",
    "fork",
    "session-tree",
    "workspace",
    "sidebar",
    "compaction"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check client.js",
    "test": "node test/smoke.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}
